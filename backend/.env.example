# Copy to .env (which is git-ignored) and set real values.
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=4000
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Comma-separated allowlist of browser origins permitted by CORS
CORS_ORIGINS=http://localhost:5173
