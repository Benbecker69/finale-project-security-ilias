# VULNERABLE: this .env file with secrets is committed to the repo on purpose.
# It demonstrates "exposed secrets / .env in repository" (Information Disclosure).
# On the secure branch, .env is git-ignored and secrets come from the CI/CD secret store.
# NOTE: all values below are FAKE demo secrets, used only for the local vulnerable demo.

PORT=4000
NODE_ENV=development

# VULNERABLE: weak, guessable, hardcoded JWT secret committed in the repo
JWT_SECRET=secret123

# VULNERABLE: tokens never expire in the vulnerable version
JWT_EXPIRES_IN=

# VULNERABLE: fake third-party credentials left in the repo
STRIPE_SECRET_KEY=sk_test_51FakeDemoKey0000000000000000ShopSecDemo
ADMIN_BOOTSTRAP_PASSWORD=Admin123!

# CORS (vulnerable: any origin reflected with credentials)
CORS_ORIGIN=*
